# ── Checador Backend ─────────────────────────────────────────────
# Copia este archivo a .env y completa los valores.

# Servidor
PORT=4000
NODE_ENV=development
# Orígenes permitidos por CORS (separados por coma). Ej: http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=10

# Storage (segundos de vigencia de URLs firmadas)
SIGNED_URL_EXPIRES_S=300

# Smart Displays (Fase 3)
# Heartbeat del WebSocket de la TV (ping + reenvío), en ms.
DISPLAY_WS_HEARTBEAT_MS=30000
# URL pública del backend para emitir wsUrl (ej: https://api.checador.mx).
# Si se omite, se deriva del request (útil en desarrollo).
PUBLIC_BASE_URL=